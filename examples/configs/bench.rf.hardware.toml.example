# RF bench template: dual PSU (VISA/ASRL), E4407B SA (GPIB), SSH to DUT host.
# Copy to examples/configs/bench.local.toml (gitignored) and adjust resources/credentials.
# driver defaults to visa (PyVISA + SCPI) when omitted.

[[equipment.psu]]
psu_id = 1
model = "tdk-genesys"  # or "generic" if Gen30-50 SCPI differs
resource = "ASRL15::INSTR"
voltage = 28.0
ovp = 30.0
ocp = 5.0

[[equipment.psu]]
psu_id = 2
model = "tdk-genesys"
resource = "ASRL16::INSTR"
voltage = 28.0
ovp = 30.0
ocp = 5.0

[[equipment.speca]]
speca_id = 1
model = "keysight-e4407b"
resource = "GPIB0::18::INSTR"
timeout = 10.0

[shared.ssh]
ssh_id = 1
host = "192.168.2.100"
port = 22
username = "root"
key_filename = "C:/path/to/id_rsa"
password = ""
timeout = 30.0
