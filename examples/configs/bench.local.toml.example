# Copy to examples/configs/bench.local.toml (gitignored) and fill in real bench resources.

[[equipment.psu]]
psu_id = 1
model = "generic"  # or "tdk-genesys"
interface = "usb"
resource = "USB0::0xXXXX::0xYYYY::INSTR"
voltage = 3.3
ovp = 3.6
ocp = 1.0

[equipment.dmm]
dmm_id = 1
model = "generic"  # or "keysight-edu34450a"
interface = "usb"
resource = "USB0::0x2A8D::0x8F01::INSTR"
timeout = 5.0

# FT232H GPIO
[[io.dio]]
dio_id = 1
driver = ftdi-ft232h
resource = ftdi://ftdi:232h/1
port_lines = 8
direction = 0x0F
