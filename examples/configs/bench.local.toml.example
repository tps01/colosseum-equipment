# Copy to examples/configs/bench.local.toml (gitignored) and fill in real bench resources.
# See docs/testing/regression-test-procedure.md for Tier 4B hardware regression.

[[equipment.psu]]
psu_id = 1
model = "generic"  # or "tdk-genesys"
interface = "usb"
resource = "USB0::0xXXXX::0xYYYY::INSTR"
voltage = 3.3
ovp = 3.6
ocp = 1.0

[equipment.dmm]
dmm_id = 1
model = "generic"  # or "keysight-edu34450a"
interface = "usb"
resource = "USB0::0x2A8D::0x8F01::INSTR"
timeout = 5.0

[shared.ssh]
ssh_id = 1
host = "192.168.1.100"
port = 22
username = "root"
key_filename = "C:/path/to/id_rsa"
password = ""
timeout = 30.0

# FT232H GPIO (requires: pip install colosseum[io])
[[io.dio]]
dio_id = 1
driver = ftdi-ft232h
resource = ftdi://ftdi:232h/1
port_lines = 8
direction = 0x0F
