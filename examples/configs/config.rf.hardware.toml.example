# RF hardware template: dual PSU (VISA/ASRL) and E4407B SA (GPIB).
# Copy to examples/configs/config.local.toml (gitignored) and adjust resources/credentials.
# driver defaults to visa (PyVISA + SCPI) when omitted.

[[equipment.psu]]
psu_id = 1
model = "tdk-genesys"  # or "generic" if Gen30-50 SCPI differs
resource = "ASRL15::INSTR"
voltage = 28.0
ovp = 30.0
ocp = 5.0

[[equipment.psu]]
psu_id = 2
model = "tdk-genesys"
resource = "ASRL16::INSTR"
voltage = 28.0
ovp = 30.0
ocp = 5.0

[[equipment.speca]]
speca_id = 1
model = "keysight-e4407b"
resource = "GPIB0::18::INSTR"
timeout = 10.0
