# RF hardware template: dual Genesys serial PSUs and E4407B SA (GPIB).
# Copy to examples/configs/config.local.toml (gitignored) and adjust resources/credentials.
# device_address is only needed when several supplies share one RS-485 bus.

[[equipment.psu]]
psu_id = 1
model = "tdk-genesys-serial"
driver = "serial"
resource = "ASRL15::INSTR"
baudrate = 9600
voltage = 28.0
ovp = 30.0
ocp = 5.0

[[equipment.psu]]
psu_id = 2
model = "tdk-genesys-serial"
driver = "serial"
resource = "ASRL16::INSTR"
baudrate = 9600
voltage = 28.0
ovp = 30.0
ocp = 5.0

[equipment.speca]
speca_id = 1
model = "keysight-e4407b"
resource = "GPIB0::18::INSTR"
timeout = 10.0
